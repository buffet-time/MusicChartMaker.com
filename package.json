{
	"name": "musicchartsite",
	"description": "A website to create Music Charts",
	"version": "1.5.2",
	"type": "module",
	"private": "true",
	"author": {
		"email": "musicChart@danielTurcich.com",
		"name": "Daniel Turcich",
		"url": "https://danielTurcich.com"
	},
	"engines": {
		"node": ">=24.3.0",
		"pnpm": ">=10.26.2"
	},
	"packageManager": "pnpm@10.26.2",
	"engineStrict": true,
	"scripts": {
		"dev": "vite",
		"dev:phone": "vite --host 8086",
		"build": "pnpm vite-build && pnpm add:cname",
		"build:preview": "vite preview",
		"preview": "pnpm build && pnpm build:preview",
		"checks": "pnpm lint-check && pnpm format-check && pnpm type-check && pnpm test",
		"lint-check": "oxlint && echo lint-check done",
		"format-check": "prettier . --check && echo format-check done",
		"type-check": "vue-tsc --noEmit && echo type-check done",
		"lint-fix": "oxlint --fix",
		"format-fix": "prettier . --write",
		"vite-build": "vite build --emptyOutDir && echo vite-build done",
		"add:cname": "cd dist && echo 'musicchartmaker.com' > CNAME && echo add:cname done",
		"prepare": "husky",
		"test": "vitest run",
		"knip": "knip",
		"analyze": "pnpm dlx vite-bundle-analyzer"
	},
	"dependencies": {
		"@popperjs/core": "^2.11.8",
		"@vueuse/core": "^14.1.0",
		"dialog-polyfill": "^0.5.6",
		"html2canvas": "^1.4.1",
		"marked": "^17.0.1",
		"pako": "^2.1.0",
		"pinia": "^3.0.4",
		"vue": "^3.5.26"
	},
	"devDependencies": {
		"@prettier/plugin-oxc": "^0.1.3",
		"@testing-library/vue": "^8.1.0",
		"@types/node": "^24.10.4",
		"@types/pako": "^2.0.4",
		"@unocss/transformer-directives": "^66.5.11",
		"@vitejs/plugin-vue": "^6.0.3",
		"happy-dom": "^20.0.11",
		"husky": "^9.1.7",
		"knip": "^5.78.0",
		"oxlint": "^1.35.0",
		"prettier": "^3.7.4",
		"rollup-plugin-swc-minify": "^1.3.0",
		"typescript": "^5.9.3",
		"unocss": "^66.5.11",
		"vite": "npm:rolldown-vite@latest",
		"vitest": "^4.0.16",
		"vue-tsc": "^3.2.1"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@swc/core",
			"esbuild",
			"oxc-resolver"
		]
	}
}
