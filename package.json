{
	"name": "musicchartsite",
	"description": "A website to create Music & Movie Charts",
	"version": "2.0.0",
	"type": "module",
	"private": "true",
	"author": {
		"email": "musicChart@danielTurcich.com",
		"name": "Daniel Turcich",
		"url": "https://danielTurcich.com"
	},
	"engines": {
		"node": ">=26.13.0",
		"pnpm": ">=12.16.1"
	},
	"packageManager": "pnpm@12.16.1",
	"engineStrict": true,
	"scripts": {
		"dev": "vite",
		"dev:phone": "vite --host 8086",
		"build": "pnpm vite-build && pnpm add:cname",
		"build:preview": "vite preview",
		"preview": "pnpm build && pnpm build:preview",
		"checks": "pnpm lint-check && pnpm format-check && pnpm type-check && pnpm test",
		"lint-check": "oxlint && echo lint-check done",
		"format-check": "oxfmt --check && echo format-check done",
		"type-check": "vue-tsc --noEmit && echo type-check done",
		"lint-fix": "oxlint --fix",
		"format-fix": "oxfmt",
		"vite-build": "vite build --emptyOutDir && echo vite-build done",
		"add:cname": "cd dist && echo 'musicchartmaker.com' > CNAME && echo add:cname done",
		"prepare": "husky",
		"test": "vitest run",
		"knip": "knip",
		"analyze": "pnpm dlx vite-bundle-analyzer"
	},
	"dependencies": {
		"@popperjs/core": "^2.11.8",
		"@vueuse/core": "^15.0.0",
		"dialog-polyfill": "^0.5.6",
		"html2canvas-pro": "^2.6.3",
		"marked": "^18.1.3",
		"pako": "^3.0.3",
		"pinia": "^4.1.0",
		"vue": "^3.5.45"
	},
	"devDependencies": {
		"@testing-library/vue": "^8.1.0",
		"@types/node": "^26.6.6",
		"@vitejs/plugin-vue": "^6.0.10",
		"happy-dom": "^21.0.4",
		"husky": "^9.1.7",
		"knip": "^6.44.1",
		"oxfmt": "^0.76.0",
		"oxlint": "^1.91.0",
		"rollup-plugin-swc-minify": "^1.3.0",
		"typescript": "^6.0.3",
		"unocss": "^66.12.0",
		"vite": "^8.3.6",
		"vitest": "^5.1.0",
		"vue-tsc": "^3.3.14"
	}
}
